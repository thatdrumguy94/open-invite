# ==============================================================================
# OpenInvite - Environment Configuration
# ==============================================================================

# Application Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-secure-random-string-in-production
PORT=5000

# Optional Demo Seeding (Seeds a sample host and event on initial startup)
AUTO_SEED=false
ADMIN_PASSWORD=change-me-to-a-secure-password

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# 1. Standalone SQLite (Default - leave blank or unset):
# DATABASE_URL=sqlite:////app/instance/open_invite.db
#
# 2. Local Docker Compose PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/event_db
#
# 3. External PostgreSQL / AWS RDS:
# DATABASE_URL=postgresql://dbuser:dbpassword@your-rds-endpoint.amazonaws.com:5432/event_db
DATABASE_URL=

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Backend choice: 'local' (offline filesystem) or 's3' (Amazon S3 / S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads

# Required only if STORAGE_BACKEND=s3:
S3_BUCKET_NAME=my-openinvite-bucket
AWS_REGION=us-east-1

# AWS Credentials (Optional if running on AWS with IAM Instance/Task Roles):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Email Service Configuration
# ------------------------------------------------------------------------------
# Choices:
#   'console'  - Prints transactional emails to server stdout (best for offline test)
#   'smtp'     - Standard SMTP server or local Mailpit inspector
#   'ses'      - Amazon Simple Email Service (SES)
#   'sendgrid' - SendGrid Web API v3
EMAIL_PROVIDER=console
MAIL_DEFAULT_SENDER=invitations@example.com

# SMTP Settings (if EMAIL_PROVIDER=smtp):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# SendGrid Settings (if EMAIL_PROVIDER=sendgrid):
SENDGRID_API_KEY=

# AWS SES Settings (if EMAIL_PROVIDER=ses):
SES_SENDER_EMAIL=invitations@example.com
